# Copy to .env and fill in real values. NEVER commit real secrets.
# Production values are set in the Render dashboard / `wrangler secret put`.

# Telegram bot token (required; set in Render env + Cloudflare worker secret)
TELEGRAM_BOT_TOKEN=

# Server-side secrets (REQUIRED in production — server refuses internal worker
# requests without WORKER_SECRET_TOKEN; user API keys are encrypted with ENCRYPTION_KEY)
SESSION_SECRET=
ENCRYPTION_KEY=

# Cloudflare Worker secrets (set via `wrangler secret put` — never in files)
WORKER_SECRET_TOKEN=
WEBHOOK_SECRET_TOKEN=

# App
RENDER_APP_URL=https://persona-life-mw90.onrender.com
PORT=5000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# MongoDB
MONGODB_URI=